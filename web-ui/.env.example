# HappyCMDB Web UI - Environment Variables
# Copy this file to .env and update with your values

# API Configuration
# Leave VITE_API_BASE_URL and VITE_GRAPHQL_URL unset for local dev. The UI then calls the relative /api/v1 and
# /graphql, and the Vite dev server proxies both to http://localhost:3001, so the browser stays same-origin.
# That matters for sign-in: the UI sends no credentials on cross-origin calls, so the browser would never send or
# store the refresh cookie and every reload would sign the user out.

# Application Configuration
VITE_APP_NAME=HappyCMDB
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DISCOVERY=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_USERS_MANAGEMENT=true

# Development
VITE_ENABLE_DEV_TOOLS=true
VITE_LOG_LEVEL=debug
