# Production Dockerfile for API Server
FROM node:20-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ git

WORKDIR /app

# Copy ALL package files (root + workspaces)
COPY package*.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/database/package.json ./packages/database/
COPY packages/unified-model/package.json ./packages/unified-model/
COPY packages/ai-discovery/package.json ./packages/ai-discovery/
COPY packages/discovery-engine/package.json ./packages/discovery-engine/
COPY packages/etl-processor/package.json ./packages/etl-processor/
COPY packages/event-processor/package.json ./packages/event-processor/
COPY packages/event-streaming/package.json ./packages/event-streaming/
COPY packages/ai-ml-engine/package.json ./packages/ai-ml-engine/
COPY packages/data-mapper/package.json ./packages/data-mapper/
COPY packages/identity-resolution/package.json ./packages/identity-resolution/
COPY packages/integration-framework/package.json ./packages/integration-framework/
COPY packages/integration-hub/package.json ./packages/integration-hub/
COPY packages/framework-integration/package.json ./packages/framework-integration/
COPY packages/itil-service-manager/package.json ./packages/itil-service-manager/
COPY packages/tbm-cost-engine/package.json ./packages/tbm-cost-engine/
COPY packages/api-server/package.json ./packages/api-server/

# Install ALL dependencies including devDependencies (needed for tsc and the build). `npm ci` installs
# exactly package-lock.json and fails if it and the package.json files disagree; `npm install` could
# resolve newer versions and rewrite the lockfile inside the image build.
RUN npm ci

# Copy tsconfig files
COPY tsconfig.base.json ./
COPY tsconfig.json ./

# Copy source files
COPY packages/common ./packages/common
COPY packages/database ./packages/database
COPY packages/unified-model ./packages/unified-model
COPY packages/ai-discovery ./packages/ai-discovery
COPY packages/discovery-engine ./packages/discovery-engine
COPY packages/etl-processor ./packages/etl-processor
COPY packages/event-processor ./packages/event-processor
COPY packages/event-streaming ./packages/event-streaming
COPY packages/ai-ml-engine ./packages/ai-ml-engine
COPY packages/data-mapper ./packages/data-mapper
COPY packages/identity-resolution ./packages/identity-resolution
COPY packages/integration-framework ./packages/integration-framework
COPY packages/integration-hub ./packages/integration-hub
COPY packages/framework-integration ./packages/framework-integration
COPY packages/itil-service-manager ./packages/itil-service-manager
COPY packages/tbm-cost-engine ./packages/tbm-cost-engine
COPY packages/api-server ./packages/api-server
COPY packages/connectors ./packages/connectors

# The root .dockerignore keeps packages/*/dist on purpose (Dockerfile.discovery and Dockerfile.etl COPY
# host-built dist), so untracked host build output arrives with the COPYs above. Remove it so tsc emits
# into an empty dist (no stale files from deleted sources). Works on any builder, unlike a
# per-Dockerfile <name>.dockerignore (BuildKit only).
RUN rm -rf packages/*/dist packages/connectors/*/dist

# Build TypeScript packages in dependency order
WORKDIR /app/packages/common
RUN npm run build

WORKDIR /app/packages/database
RUN npm run build

WORKDIR /app/packages/unified-model
RUN npm run build

WORKDIR /app/packages/ai-discovery
RUN npm run build

WORKDIR /app/packages/discovery-engine
RUN npm run build

WORKDIR /app/packages/etl-processor
RUN npm run build

WORKDIR /app/packages/event-processor
RUN npm run build

WORKDIR /app/packages/event-streaming
RUN npm run build

WORKDIR /app/packages/ai-ml-engine
RUN npm run build

WORKDIR /app/packages/data-mapper
RUN npm run build

WORKDIR /app/packages/integration-framework
RUN npm run build

WORKDIR /app/packages/identity-resolution
RUN npm run build

WORKDIR /app/packages/itil-service-manager
RUN npm run build

WORKDIR /app/packages/tbm-cost-engine
RUN npm run build

# Built after itil-service-manager and tbm-cost-engine: it references both
# (tsc composite references), so building it earlier fails with TS2307.
WORKDIR /app/packages/framework-integration
RUN npm run build

WORKDIR /app/packages/api-server
RUN npm run build

WORKDIR /app/packages/integration-hub
RUN npm run build
RUN npm run test:compiled-entry

# Trim the tree the production stage copies: devDependencies (npm prune --omit=dev) and test files. The
# test:compiled-entry run above is the last step that needs them. src/ stays: packages/database ships its
# SQL migrations under src/postgres/migrations. packages/connectors keeps its connector.json files, which
# ConnectorLoader reads at start-up.
WORKDIR /app
RUN npm prune --omit=dev && \
    find packages -name node_modules -prune -o \
      \( -type d \( -name __tests__ -o -name __mocks__ \) -o -type f \( -name '*.test.*' -o -name '*.spec.*' \) \) \
      -prune -exec rm -rf {} + && \
    rm -rf packages/*/tests

# Production stage
FROM node:20-alpine

# Install runtime dependencies (including nmap for network discovery)
RUN apk add --no-cache dumb-init curl nmap nmap-scripts

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S -G nodejs -u 1001 nodejs

WORKDIR /app

# Copy package files (owned by nodejs at copy time; a recursive chown over
# node_modules rewrote every file on the overlay FS and took 30-50+ min, HAP-1141)
COPY --chown=nodejs:nodejs package*.json ./

# Copy ALL built packages and node_modules from builder
# This avoids workspace resolution issues in production
COPY --chown=nodejs:nodejs --from=builder /app/node_modules ./node_modules
COPY --chown=nodejs:nodejs --from=builder /app/packages ./packages

# /app itself must stay writable by nodejs (winston creates /app/logs in production).
# Non-recursive: every file below it was already chowned by the COPYs above.
RUN chown nodejs:nodejs /app

# nmap gets no file caps (HAP-1755). It chooses privileged mode from euid, or when forced with --privileged / NMAP_PRIVILEGED, never from file caps, so they were dead weight. A +eip cap_net_admin,cap_net_raw file cap made the kernel refuse the exec whenever the container's bounding set lacked either cap: Docker's default set has NET_RAW but no NET_ADMIN (the real failure under default caps), and --cap-drop ALL / Pod Security restricted drop both. Through the dumb-init ENTRYPOINT that refusal surfaced as rc 2 ("[dumb-init] nmap: Operation not permitted"); only a direct `--entrypoint nmap` gives rc 255.

# Switch to non-root user
USER nodejs

# Expose API port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=production \
    PORT=3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/v1/cmdb-health/alive || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the API server
CMD ["node", "packages/api-server/dist/index.js"]
